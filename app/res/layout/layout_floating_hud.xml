<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/hudRoot"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">

    <!-- ============================================================= -->
    <!-- 1. COMPACT HUD PILL (Docked on Left Screen Edge)               -->
    <!-- ============================================================= -->
    <LinearLayout
        android:id="@+id/hudPillContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_hud_pill_left"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="7dp"
        android:paddingBottom="7dp"
        android:clickable="true"
        android:focusable="true">

        <View
            android:id="@+id/ivPillBleStatusDot"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:background="@drawable/bg_pulse_dot"
            android:layout_marginEnd="8dp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginEnd="8dp">

            <TextView
                android:id="@+id/tvPillSpeed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/gps_speed_default"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:textStyle="bold"
                android:includeFontPadding="false" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="KM/H"
                android:textColor="@color/pulsar_cyan"
                android:textSize="7sp"
                android:textStyle="bold"
                android:includeFontPadding="false" />
        </LinearLayout>

        <View
            android:layout_width="1dp"
            android:layout_height="18dp"
            android:background="#1E293B"
            android:layout_marginEnd="8dp" />

        <ImageView
            android:id="@+id/ivPillPlayPause"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_media_play"
            android:tint="@color/pulsar_cyan"
            android:contentDescription="@string/content_desc_play_pause"
            android:layout_marginEnd="6dp" />

        <ImageView
            android:id="@+id/ivPillExpand"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_chevron_right"
            android:tint="@color/text_secondary"
            android:contentDescription="@string/copilot_title" />
    </LinearLayout>

    <!-- ============================================================= -->
    <!-- 2. EXPANDED RIDER DOCK (~25% Landscape Overlay)               -->
    <!-- ============================================================= -->
    <LinearLayout
        android:id="@+id/hudDockContainer"
        android:layout_width="280dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_hud_dock_left"
        android:padding="12dp"
        android:visibility="gone">

        <!-- Header: Bike Identity & Collapse Button -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <View
                android:id="@+id/ivDockBleStatusDot"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:background="@drawable/bg_pulse_dot"
                android:layout_marginEnd="6dp" />

            <TextView
                android:id="@+id/tvDockBikeName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/bike_default_name"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                android:textStyle="bold"
                android:singleLine="true" />

            <ImageView
                android:id="@+id/btnDockCollapse"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_chevron_left"
                android:background="@drawable/bg_circle_action"
                android:padding="6dp"
                android:contentDescription="@string/hud_dock_collapse" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvDockBleStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/status_disconnected"
            android:textColor="@color/pulsar_red"
            android:textSize="10sp"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="8dp" />

        <!-- Speed & Telemetry Block -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="bottom">

                <TextView
                    android:id="@+id/tvDockSpeed"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/gps_speed_default"
                    android:textColor="@color/text_primary"
                    android:textSize="28sp"
                    android:textStyle="bold"
                    android:includeFontPadding="false" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=" KM/H"
                    android:textColor="@color/pulsar_cyan"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:layout_marginStart="4dp"
                    android:layout_marginBottom="4dp" />
            </LinearLayout>

            <TextView
                android:id="@+id/btnDockBleAction"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/action_connect"
                android:textColor="@color/pulsar_cyan"
                android:textSize="10sp"
                android:textStyle="bold"
                android:background="@drawable/bg_chip_action"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="5dp"
                android:paddingBottom="5dp" />
        </LinearLayout>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#1E293B"
            android:layout_marginBottom="8dp" />

        <!-- Media Deck -->
        <TextView
            android:id="@+id/tvDockSongTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/media_no_music"
            android:textColor="@color/text_primary"
            android:textSize="12sp"
            android:textStyle="bold"
            android:singleLine="true"
            android:ellipsize="marquee"
            android:marqueeRepeatLimit="marquee_forever" />

        <TextView
            android:id="@+id/tvDockArtist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/media_launch_hint"
            android:textColor="@color/text_secondary"
            android:textSize="10sp"
            android:singleLine="true"
            android:layout_marginTop="1dp"
            android:layout_marginBottom="8dp" />

        <!-- Glove Controls -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="8dp">

            <ImageView
                android:id="@+id/btnDockPrev"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:src="@drawable/ic_media_prev"
                android:background="@drawable/bg_circle_action"
                android:padding="8dp"
                android:tint="@color/text_primary"
                android:contentDescription="@string/content_desc_prev"
                android:layout_marginEnd="14dp" />

            <ImageView
                android:id="@+id/btnDockPlayPause"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_media_play"
                android:background="@drawable/bg_circle_action"
                android:padding="10dp"
                android:tint="@color/pulsar_cyan"
                android:contentDescription="@string/content_desc_play_pause"
                android:layout_marginEnd="14dp" />

            <ImageView
                android:id="@+id/btnDockNext"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:src="@drawable/ic_media_next"
                android:background="@drawable/bg_circle_action"
                android:padding="8dp"
                android:tint="@color/text_primary"
                android:contentDescription="@string/content_desc_next" />
        </LinearLayout>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#1E293B"
            android:layout_marginBottom="8dp" />

        <!-- Bottom Actions -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/btnDockMaps"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/action_open_maps"
                android:textColor="@color/pulsar_cyan"
                android:textSize="10sp"
                android:textStyle="bold"
                android:background="@drawable/bg_chip_action"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/btnDockDismiss"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/hud_dock_dismiss"
                android:textColor="@color/pulsar_red"
                android:textSize="10sp"
                android:padding="4dp" />
        </LinearLayout>
    </LinearLayout>

</FrameLayout>
