<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Header -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Bajaj Pulsar NS400Z"
            android:textColor="@color/accent_blue"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Google Maps Turn-by-Turn BLE Bridge"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:layout_marginBottom="16dp" />

        <!-- Cluster Connection Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/card_bg"
            android:padding="16dp"
            android:orientation="vertical"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MOTORCYCLE CLUSTER (BLE GATT 0110)"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvBleStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Status: Disconnected"
                android:textColor="@color/accent_red"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginTop="6dp" />

            <TextView
                android:id="@+id/tvDeviceInfo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Target: Auto-detecting OTC / NS400Z"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:layout_marginTop="2dp" />

            <Button
                android:id="@+id/btnConnectBle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Scan &amp; Connect NS400Z"
                android:backgroundTint="@color/btn_bg"
                android:textColor="@color/text_primary"
                android:layout_marginTop="12dp" />
        </LinearLayout>

        <!-- Permission Access Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/card_bg"
            android:padding="16dp"
            android:orientation="vertical"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="GOOGLE MAPS ACCESS"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvNotifStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Notification Hook: Pending Permission"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:layout_marginTop="6dp" />

            <Button
                android:id="@+id/btnGrantNotif"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Enable Notification Access"
                android:backgroundTint="@color/card_border"
                android:textColor="@color/text_primary"
                android:layout_marginTop="10dp" />
        </LinearLayout>

        <!-- Live Navigation Feed Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/card_bg"
            android:padding="16dp"
            android:orientation="vertical"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="LIVE NAVIGATION FEED"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvNavManeuver"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Maneuver: IDLE / NO ACTIVE TRIP"
                android:textColor="@color/accent_blue"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginTop="6dp" />

            <TextView
                android:id="@+id/tvNavDetails"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Step Dist: -- | Total: -- | ETA: --"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:layout_marginTop="4dp" />

            <TextView
                android:id="@+id/tvNavStreet"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Street: --"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:layout_marginTop="2dp" />

            <TextView
                android:id="@+id/tvRawHex"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Raw BLE Frame: (None)"
                android:textColor="#6EE7B7"
                android:textSize="11sp"
                android:fontFamily="monospace"
                android:background="#0B1120"
                android:padding="8dp"
                android:layout_marginTop="10dp" />
        </LinearLayout>

        <!-- Quick Test Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/card_bg"
            android:padding="16dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CLUSTER SIMULATION TESTS"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="10dp">

                <Button
                    android:id="@+id/btnTestLeft"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Test Left 250m"
                    android:backgroundTint="#059669"
                    android:textSize="12sp"
                    android:layout_marginEnd="6dp" />

                <Button
                    android:id="@+id/btnTestRight"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Test Right 500m"
                    android:backgroundTint="#0D9488"
                    android:textSize="12sp" />
            </LinearLayout>

            <Button
                android:id="@+id/btnTestClear"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Clear / Stop Navigation Display"
                android:backgroundTint="#475569"
                android:layout_marginTop="8dp" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
